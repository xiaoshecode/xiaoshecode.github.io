---
import { site } from '../data/site';
import { ui } from '../i18n';
import L from './L.astro';

const nav = ['about', 'news', 'publications', 'projects', 'contact'] as const;
---
<header class="site-header" data-header>
  <div class="wrap header-inner">
    <a class="brand" href="#top">{site.name.en}</a>
    <nav class="site-nav" aria-label="Sections">
      {nav.map((id) => (
        <a href={`#${id}`}><L en={ui[id].en} zh={ui[id].zh} /></a>
      ))}
    </nav>
    <div class="controls">
      <button type="button" class="ctrl-btn" data-lang-toggle aria-label="Switch language / 切换语言">
        <span data-lang="en">中文</span><span data-lang="zh">EN</span>
      </button>
      <button type="button" class="ctrl-btn icon-btn" data-theme-toggle aria-label="Toggle color theme / 切换主题">
        <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="4.5" />
          <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" />
        </svg>
        <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 13.5A8.5 8.5 0 0 1 10.5 4 7 7 0 1 0 20 13.5z" />
        </svg>
      </button>
    </div>
  </div>
</header>
