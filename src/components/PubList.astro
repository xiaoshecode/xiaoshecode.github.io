---
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'publications'>[];
}
const { items } = Astro.props;
---
<div class="pubs">
  {items.map((p) => (
    <article class:list={['pub', { 'no-img': !p.data.image }]}>
      {p.data.image && (
        <img class="pub-thumb" src={p.data.image} alt="" loading="lazy" width="400" height="300" />
      )}
      <div class="pub-body">
        <h3 class="pub-title" set:html={p.data.title} />
        <p class="pub-authors" set:html={p.data.authors} />
        <p class="pub-venue">{p.data.venue}</p>
        {p.data.links.length > 0 && (
          <p class="pub-links">
            {p.data.links.map((l) => (
              <a class="u" href={l.url} rel="noopener">[{l.label}]</a>
            ))}
          </p>
        )}
      </div>
    </article>
  ))}
</div>
